---
interface Props {
  active?: 'latest' | 'archive';
}

const { active = 'latest' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="wordmark" href={base}>The Daily Brief</a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href={base} aria-current={active === 'latest' ? 'page' : undefined}>Latest</a>
      <a href={`${base}archive/`} aria-current={active === 'archive' ? 'page' : undefined}>Archive</a>
    </nav>
  </div>
</header>
