---
import { Button } from '@/components/starwind/button';
import Wordmark from './Wordmark.astro';

interface Props {
  active?: 'latest' | 'archive' | 'compare' | 'review' | 'about';
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="masthead">
  <div class="masthead-inner">
    <Wordmark href={base} />
    <div class="site-actions">
      <Button
        href={`${base}about/`}
        variant="ghost"
        size="sm"
        class="px-2 text-[color:var(--muted-copy)] aria-[current=page]:text-[color:var(--theme-accent-text)]"
        aria-current={active === 'about' ? 'page' : undefined}
      >About</Button>
      <Button
        type="button"
        variant="ghost"
        size="sm"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Switch to dark mode"
        aria-pressed="false"
      >
        <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16.5 12.1A7 7 0 0 1 7.9 3.5 7 7 0 1 0 16.5 12.1Z" />
        </svg>
        <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="10" cy="10" r="3.25" />
          <path d="M10 1.75v2M10 16.25v2M18.25 10h-2M3.75 10h-2m14.08-5.83-1.42 1.42M5.59 14.41l-1.42 1.42m11.66 0-1.42-1.42M5.59 5.59 4.17 4.17" />
        </svg>
      </Button>
    </div>
  </div>
</header>
