---
import { formatPublicationTimestamp, formatRelativeAge, type SourceCollection } from '../content';
import '../styles/navigation.css';

interface Props {
  groups: SourceCollection[];
}

const { groups } = Astro.props;
const topics = [...new Set(groups.map((group) => group.category))];
const newestPublishedAt = (group: SourceCollection) => {
  const dates = group.stories
    .map((story) => story.publishedAt)
    .filter((date): date is string => !!date && Number.isFinite(Date.parse(date)));
  return dates.sort((left, right) => Date.parse(right) - Date.parse(left))[0] ?? null;
};
---

<div class="source-navigator" data-source-navigator aria-label="Source navigation">
  <div class="navigator-switcher" aria-label="Browse sources">
    <button class="navigator-current" type="button" data-open-sources aria-haspopup="dialog" aria-controls="source-picker" aria-expanded="false">
      <span class="navigator-display">
        <span class="navigator-current-name" data-current-name>Choose a source</span>
        <span class="navigator-current-name navigator-outgoing-name" data-outgoing-name aria-hidden="true"></span>
        <span class="navigator-open-mark" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="m6 7 4-4 4 4m-8 6 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </span>
    </button>
    <div class="navigator-arrows" role="group" aria-label="Previous and next source">
      <button class="navigator-arrow" type="button" data-nav-prev aria-label="Previous source">
        <svg aria-hidden="true" width="22" height="18" viewBox="0 0 24 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 10H2m4-4-4 4 4 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="navigator-arrow" type="button" data-nav-next aria-label="Next source">
        <svg aria-hidden="true" width="22" height="18" viewBox="0 0 24 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 10h20m-4-4 4 4-4 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <dialog id="source-picker" class="source-picker" aria-labelledby="source-picker-title">
    <div class="picker-sheet">
      <div class="picker-grabber" aria-hidden="true"></div>
      <header class="picker-header">
        <div><h2 id="source-picker-title" tabindex="-1">All sources</h2></div>
        <button class="picker-close" type="button" data-close-sources aria-label="Close source list">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="m4 4 10 10M14 4 4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </header>
      <div class="picker-results" data-picker-results>
        {topics.map((topic) => {
          const topicGroups = groups.filter((group) => group.category === topic);
          return (
          <section class="picker-topic" data-picker-topic={topic} aria-label={topic}>
            <h3>
              <span>{topic === 'Technology' ? 'Tech' : topic}</span>
              <span class="picker-topic-count">{topicGroups.length} {topicGroups.length === 1 ? 'source' : 'sources'}</span>
            </h3>
            <div class="picker-topic-sources">
              {topicGroups.map((group) => (
                <button class="picker-source" type="button" data-source-id={`source-${groups.indexOf(group)}`} data-picker-source data-source-name={group.displayName ?? group.name}>
                  <span class="picker-source-name">{group.displayName ?? group.name}</span>
                  <span class="picker-source-age"><time datetime={newestPublishedAt(group) ?? undefined} title={formatPublicationTimestamp(newestPublishedAt(group))} data-relative-age>{formatRelativeAge(newestPublishedAt(group))}</time></span>
                </button>
              ))}
            </div>
          </section>
          );
        })}
      </div>
      <footer class="picker-footer">
        <span>{groups.length} {groups.length === 1 ? 'source' : 'sources'}</span>
        <span>Time since latest story</span>
      </footer>
    </div>
  </dialog>
</div>

<script>
  const nav = document.querySelector<HTMLElement>('[data-source-navigator]');
  const sourceList = document.querySelector<HTMLElement>('#source-list');
  if (nav && sourceList) {
    const allGroups = [...sourceList.querySelectorAll<HTMLElement>('.source-group')];
    const prev = nav.querySelector<HTMLButtonElement>('[data-nav-prev]')!;
    const next = nav.querySelector<HTMLButtonElement>('[data-nav-next]')!;
    const currentName = nav.querySelector<HTMLElement>('[data-current-name]')!;
    const outgoingName = nav.querySelector<HTMLElement>('[data-outgoing-name]')!;
    const sourceSwitcher = nav.querySelector<HTMLButtonElement>('.navigator-current')!;
    const reducedLabelMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sourceTransitionDuration = 300;
    const springPeakAt = .62;

    function cubicBezierAt(time: number, x1: number, y1: number, x2: number, y2: number) {
      const curve = (t: number, a: number, b: number) => 3 * (1 - t) ** 2 * t * a + 3 * (1 - t) * t ** 2 * b + t ** 3;
      let low = 0;
      let high = 1;
      for (let i = 0; i < 16; i++) {
        const middle = (low + high) / 2;
        if (curve(middle, x1, x2) < time) low = middle;
        else high = middle;
      }
      return curve((low + high) / 2, y1, y2);
    }

    function sourceSpringProgress(time: number, overshoot: number) {
      if (time <= springPeakAt) {
        const eased = cubicBezierAt(time / springPeakAt, .5, 0, .75, .2);
        return eased * overshoot;
      }
      const eased = cubicBezierAt((time - springPeakAt) / (1 - springPeakAt), .4, 0, .7, 1);
      return overshoot + (1 - overshoot) * eased;
    }
    let labelSourceId: string | undefined;
    let labelInitialized = false;
    let labelAnimations: Animation[] = [];

    function settleLabel() {
      labelAnimations.forEach((animation) => animation.cancel());
      labelAnimations = [];
      outgoingName.textContent = '';
    }

    reducedLabelMotion.addEventListener('change', () => {
      if (reducedLabelMotion.matches) settleLabel();
    });

    function updateSourceLabel() {
      const name = current?.dataset.sourceName ?? 'No sources in this topic';
      if (labelInitialized && labelSourceId === current?.id) return;
      const previousIndex = allGroups.findIndex((group) => group.id === labelSourceId);
      const nextIndex = current ? allGroups.indexOf(current) : -1;
      const previousName = currentName.textContent;
      settleLabel();
      currentName.textContent = name;
      sourceSwitcher.setAttribute('aria-label', `Choose source: ${name}`);
      sourceSwitcher.title = name;
      const shouldAnimate = labelInitialized && !reducedLabelMotion.matches
        && previousIndex >= 0 && nextIndex >= 0
        && sourceSwitcher.getClientRects().length > 0;
      labelInitialized = true;
      labelSourceId = current?.id;
      if (!shouldAnimate) return;

      outgoingName.textContent = previousName;
      // Both labels ride the same indexed wheel: forward rolls up, backward down.
      // Clear the entire window before entering; percentage-of-label travel left
      // a sliver of the incoming text visible at the edge of this taller display.
      const direction = nextIndex > previousIndex ? 1 : -1;
      const display = currentName.parentElement!;
      const travel = (display.clientHeight + currentName.offsetHeight) / 2 + 2;
      const pitch = direction * travel;
      const stops = [
        { progress: 0, offset: 0, easing: 'cubic-bezier(.5, 0, .75, .2)' },
        { progress: 1 + 2 / travel, offset: springPeakAt, easing: 'cubic-bezier(.4, 0, .7, 1)' },
        { progress: 1, offset: 1, easing: 'cubic-bezier(.4, 0, .7, 1)' },
      ];
      const options = { duration: sourceTransitionDuration, fill: 'both' as FillMode };
      const outgoing = outgoingName.animate(stops.map(({ progress, ...timing }) => ({
        ...timing, transform: `translateY(${-pitch * progress}px)`,
      })), options);
      const incoming = currentName.animate(stops.map(({ progress, ...timing }) => ({
        ...timing, transform: `translateY(${pitch * (1 - progress)}px)`,
      })), options);
      labelAnimations = [outgoing, incoming];
      incoming.onfinish = settleLabel;
    }
    const dialog = nav.querySelector<HTMLDialogElement>('.source-picker')!;
    const pickerTitle = nav.querySelector<HTMLElement>('#source-picker-title')!;
    const results = nav.querySelector<HTMLElement>('[data-picker-results]')!;
    const sourceButtons = [...nav.querySelectorAll<HTMLButtonElement>('[data-picker-source]')];
    let visibleGroups: HTMLElement[] = [];
    let current: HTMLElement | undefined;
    let explicitlySelected = false;
    let scrollPending = false;
    let opener: HTMLButtonElement | null = null;
    let keepFocusAfterClose = false;
    let choosingFilteredSource = false;
    let pendingTarget: HTMLElement | undefined;
    let animatedScrollTarget: HTMLElement | undefined;
    let pendingTimer = 0;

    function refreshVisible() {
      visibleGroups = allGroups.filter((group) => !group.hidden);
      sourceButtons.forEach((button) => {
        const group = allGroups.find((item) => item.id === button.dataset.sourceId);
        button.classList.toggle('is-current', group === current);
        button.setAttribute('aria-pressed', String(group === current));
      });
      if (!visibleGroups.includes(current!)) current = visibleGroups[0];
      if (!visibleGroups.length) current = undefined;
      updateControls();
    }

    function updateControls() {
      const index = current ? visibleGroups.indexOf(current) : -1;
      updateSourceLabel();
      prev.disabled = index <= 0;
      next.disabled = !nextSource();
      sourceButtons.forEach((button) => {
        const group = allGroups.find((item) => item.id === button.dataset.sourceId);
        button.classList.toggle('is-current', group === current);
        button.setAttribute('aria-pressed', String(group === current));
      });
    }

    function stickyOffset() {
      if (window.matchMedia('(max-width: 640px)').matches) {
        const stickyTopics = document.querySelector<HTMLElement>('.topic-bar.is-pinned');
        if (stickyTopics) return stickyTopics.getBoundingClientRect().height + 12;
        const chip = document.querySelector<HTMLElement>('.topic-bar .filter');
        // The pinned bar uses one row of chips, with 20px of padding and a 1px border.
        return (chip?.getBoundingClientRect().height ?? 32) + 21 + 12;
      }
      const topicBar = document.querySelector<HTMLElement>('.topic-bar');
      return (topicBar?.getBoundingClientRect().height ?? 0) + 12;
    }

    function sourceScrollTop(group: HTMLElement) {
      const top = group.getBoundingClientRect().top + window.scrollY - stickyOffset();
      const topicSlot = window.matchMedia('(max-width: 640px)').matches
        ? document.querySelector<HTMLElement>('.topic-bar-slot')
        : null;
      const pinTop = topicSlot ? Math.ceil(topicSlot.getBoundingClientRect().top + window.scrollY) : 0;
      return Math.max(0, pinTop, top);
    }

    function nextSource() {
      const first = visibleGroups[0];
      if (first && window.matchMedia('(max-width: 640px)').matches && sourceScrollTop(first) - window.scrollY > 1) {
        return first;
      }
      const index = current ? visibleGroups.indexOf(current) : -1;
      return index >= 0 ? visibleGroups[index + 1] : undefined;
    }

    function animateSourceScroll(group: HTMLElement, top: number, duration: number, focusDestination: boolean) {
      const startY = window.scrollY;
      const distance = top - startY;
      const startTime = performance.now();

      function step(now: number) {
        if (pendingTarget !== group || animatedScrollTarget !== group) return;
        const progress = Math.min(1, (now - startTime) / duration);
        const eased = sourceSpringProgress(progress, 1);
        window.scrollTo(0, startY + distance * eased);
        if (progress < 1) {
          requestAnimationFrame(step);
          return;
        }

        animatedScrollTarget = undefined;
        window.clearTimeout(pendingTimer);
        pendingTarget = undefined;
        document.documentElement.classList.remove('is-source-scrolling');
        updateCurrentFromScroll();
        if (focusDestination) group.focus({ preventScroll: true });
      }

      requestAnimationFrame(step);
    }

    function jumpTo(group: HTMLElement, selected = true, focusDestination = false) {
      if (group.hidden) return;
      current = group;
      explicitlySelected = selected;
      updateControls();
      const top = sourceScrollTop(group);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      pendingTarget = group;
      animatedScrollTarget = undefined;
      window.clearTimeout(pendingTimer);
      document.documentElement.classList.remove('is-source-scrolling');
      if (!reducedMotion) {
        const duration = sourceTransitionDuration;
        animatedScrollTarget = group;
        document.documentElement.classList.add('is-source-scrolling');
        pendingTimer = window.setTimeout(() => {
          if (pendingTarget !== group) return;
          animatedScrollTarget = undefined;
          pendingTarget = undefined;
          document.documentElement.classList.remove('is-source-scrolling');
          updateCurrentFromScroll();
          if (focusDestination) group.focus({ preventScroll: true });
        }, duration + 150);
        animateSourceScroll(group, top, duration, focusDestination);
        return;
      }
      pendingTimer = window.setTimeout(() => {
        pendingTarget = undefined;
        updateCurrentFromScroll();
      }, 100);
      window.scrollTo({ top, behavior: 'instant' });
      if (focusDestination) group.focus({ preventScroll: true });
    }

    function openPicker(event: Event) {
      opener = event.currentTarget as HTMLButtonElement;
      refreshVisible();
      if (!dialog.open) {
        dialog.showModal();
        if (window.matchMedia('(max-width: 640px)').matches
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const openingAnimation = dialog.animate(
            [{ transform: 'translateY(100%)' }, { transform: 'translateY(0)' }],
            { duration: 240, easing: 'cubic-bezier(.22, 1, .36, 1)' },
          );
          sheetAnimation = openingAnimation;
          openingAnimation.onfinish = () => {
            if (sheetAnimation === openingAnimation) sheetAnimation = undefined;
          };
        }
      }
      sourceSwitcher.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => {
        pickerTitle.focus({ preventScroll: true });
        results.scrollTop = 0;
        const active = sourceButtons.find((button) => button.classList.contains('is-current') && !button.hidden);
        const topicHeading = active?.closest<HTMLElement>('[data-picker-topic]')?.querySelector<HTMLElement>('h3');
        if (topicHeading) {
          const resultsTop = results.getBoundingClientRect().top + 12;
          const headingTop = topicHeading.getBoundingClientRect().top;
          results.scrollTop += headingTop - resultsTop;
          if (active) {
            const visibleTop = results.getBoundingClientRect().top + 8;
            const visibleBottom = results.getBoundingClientRect().bottom - 8;
            const activeRect = active.getBoundingClientRect();
            if (activeRect.top < visibleTop) results.scrollTop -= visibleTop - activeRect.top;
            else if (activeRect.bottom > visibleBottom) results.scrollTop += activeRect.bottom - visibleBottom;
          }
        }
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-open-sources]').forEach((button) => {
      button.addEventListener('click', openPicker);
    });
    nav.querySelector<HTMLButtonElement>('[data-close-sources]')?.addEventListener('click', () => dialog.close());
    let sheetTouch: { x: number; y: number; time: number; dragging: boolean } | undefined;
    let sheetDistance = 0;
    let sheetAnimation: Animation | undefined;
    let suppressSheetClickUntil = 0;

    function settleSheet(dismiss: boolean) {
      sheetTouch = undefined;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finish = () => {
        if (dismiss && dialog.open) dialog.close();
        dialog.style.removeProperty('transform');
        sheetAnimation = undefined;
        sheetDistance = 0;
      };
      if (reducedMotion) {
        finish();
        return;
      }
      sheetAnimation = dialog.animate(
        [{ transform: `translateY(${sheetDistance}px)` }, { transform: dismiss ? 'translateY(100%)' : 'translateY(0)' }],
        { duration: dismiss ? 180 : 150, easing: 'ease-out' },
      );
      sheetAnimation.onfinish = finish;
    }

    dialog.addEventListener('touchstart', (event) => {
      if (!window.matchMedia('(max-width: 640px)').matches || sheetAnimation || event.touches.length !== 1) return;
      const inList = event.target instanceof Node && results.contains(event.target);
      if (inList && results.scrollTop > 1) return;
      const touch = event.touches[0];
      sheetTouch = { x: touch.clientX, y: touch.clientY, time: performance.now(), dragging: false };
      sheetDistance = 0;
    }, { passive: true });

    dialog.addEventListener('touchmove', (event) => {
      if (!sheetTouch) return;
      if (event.touches.length !== 1) {
        settleSheet(false);
        return;
      }
      const touch = event.touches[0];
      const distance = touch.clientY - sheetTouch.y;
      if (!sheetTouch.dragging) {
        if (Math.abs(distance) < 8 && Math.abs(touch.clientX - sheetTouch.x) < 8) return;
        if (distance <= 0 || Math.abs(touch.clientX - sheetTouch.x) > distance) {
          sheetTouch = undefined;
          return;
        }
        sheetTouch.dragging = true;
      }
      if (!event.cancelable) {
        settleSheet(false);
        return;
      }
      event.preventDefault();
      sheetDistance = Math.max(0, distance);
      dialog.style.transform = `translateY(${sheetDistance}px)`;
      suppressSheetClickUntil = performance.now() + 400;
    }, { passive: false });

    dialog.addEventListener('touchend', () => {
      if (!sheetTouch) return;
      if (!sheetTouch.dragging) {
        sheetTouch = undefined;
        return;
      }
      const speed = sheetDistance / Math.max(1, performance.now() - sheetTouch.time);
      settleSheet(sheetDistance >= 80 || (sheetDistance >= 28 && speed > .5));
    });
    dialog.addEventListener('touchcancel', () => {
      if (sheetTouch) settleSheet(false);
    });
    dialog.addEventListener('click', (event) => {
      if (performance.now() < suppressSheetClickUntil) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    }, { capture: true });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      sourceSwitcher.setAttribute('aria-expanded', 'false');
      sheetAnimation?.cancel();
      sheetAnimation = undefined;
      sheetTouch = undefined;
      sheetDistance = 0;
      dialog.style.removeProperty('transform');
      if (keepFocusAfterClose) {
        keepFocusAfterClose = false;
        return;
      }
      if (opener?.isConnected && opener.getClientRects().length) {
        opener.focus();
      } else {
        [...document.querySelectorAll<HTMLButtonElement>('[data-open-sources]')]
          .find((button) => button.getClientRects().length > 0)
          ?.focus();
      }
    });
    sourceButtons.forEach((button) => button.addEventListener('click', () => {
      const group = allGroups.find((item) => item.id === button.dataset.sourceId);
      if (group?.hidden) {
        choosingFilteredSource = true;
        document.dispatchEvent(new CustomEvent('source-category-reset'));
        choosingFilteredSource = false;
      }
      keepFocusAfterClose = true;
      dialog.close();
      if (group) jumpTo(group, true, true);
    }));
    prev.addEventListener('click', () => {
      const index = current ? visibleGroups.indexOf(current) : -1;
      if (index > 0) jumpTo(visibleGroups[index - 1]);
    });
    next.addEventListener('click', () => {
      const target = nextSource();
      if (target && target !== pendingTarget) jumpTo(target);
    });

    function updateCurrentFromScroll() {
      if (!visibleGroups.length) return;
      if (pendingTarget && visibleGroups.includes(pendingTarget)) return;
      const mobileDock = window.matchMedia('(max-width: 640px)').matches;
      const threshold = mobileDock
        ? stickyOffset() + 24
        : (document.querySelector<HTMLElement>('.topic-bar')?.getBoundingClientRect().height ?? 0) + 36;
      let anchor = visibleGroups[0];
      for (const group of visibleGroups) {
        if (group.getBoundingClientRect().top > threshold) break;
        anchor = group;
      }
      const anchorTop = anchor.getBoundingClientRect().top;
      const row = visibleGroups.filter((group) => Math.abs(group.getBoundingClientRect().top - anchorTop) < 28);
      if (explicitlySelected && current && row.includes(current)) {
        // Preserve a deliberate choice while its desktop row remains current.
      } else {
        current = row[0] ?? anchor;
        explicitlySelected = false;
      }
      updateControls();
    }
    window.addEventListener('scroll', () => {
      if (scrollPending) return;
      scrollPending = true;
      requestAnimationFrame(() => { scrollPending = false; updateCurrentFromScroll(); });
    }, { passive: true });
    window.addEventListener('scrollend', () => {
      if (!pendingTarget || animatedScrollTarget) return;
      pendingTarget = undefined;
      window.clearTimeout(pendingTimer);
      updateCurrentFromScroll();
    });
    function interruptPendingScroll() {
      animatedScrollTarget = undefined;
      pendingTarget = undefined;
      document.documentElement.classList.remove('is-source-scrolling');
      window.clearTimeout(pendingTimer);
    }
    window.addEventListener('wheel', interruptPendingScroll, { passive: true });
    window.addEventListener('touchstart', interruptPendingScroll, { passive: true });
    document.addEventListener('sources-filtered', (event) => {
      if (event instanceof CustomEvent && event.detail?.scrollHandled) {
        interruptPendingScroll();
        refreshVisible();
        return;
      }
      if (choosingFilteredSource) {
        refreshVisible();
        return;
      }
      const oldCurrent = current;
      const listDocumentTop = sourceList.getBoundingClientRect().top + window.scrollY;
      const wasReadingContent = window.scrollY > listDocumentTop - stickyOffset();
      refreshVisible();
      if (wasReadingContent && oldCurrent && oldCurrent.hidden && visibleGroups[0]) jumpTo(visibleGroups[0], false);
      else updateCurrentFromScroll();
    });
    window.addEventListener('resize', () => updateCurrentFromScroll());
    refreshVisible();
  }
</script>
