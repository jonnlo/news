---
import { Card, CardContent } from '@/components/starwind/card';
import { formatRelativeAge, type Story } from '@/content';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const excerpt = story.source === 'Hacker News' ? null : story.excerpt.replace(/\s+$/, '');
let articleDomain: string | null = null;
if (story.source === 'Hacker News') {
  try {
    const url = new URL(story.url);
    if (url.protocol === 'https:' || url.protocol === 'http:') articleDomain = url.hostname.replace(/^www\./, '');
  } catch { /* Older or malformed links may not identify a publisher. */ }
}
---

<article class="story" data-category={story.category}>
  <Card size="sm" class="story-card ring-0">
    <CardContent class="story-content">
      <div class="story-copy">
        <h2 class="story-title">
          <a href={story.url} target="_blank" rel="noreferrer">{story.title}</a>
        </h2>
        {excerpt && <p class="story-excerpt">{excerpt}</p>}
        <div class="story-meta">
          <time
            class="story-age"
            datetime={story.publishedAt ?? undefined}
            data-relative-age
          >
            {formatRelativeAge(story.publishedAt)}
          </time>
          <span class="story-meta-separator" aria-hidden="true">·</span>
          {articleDomain && (
            <>
              <a class="story-source" href={story.url} target="_blank" rel="noreferrer" aria-label={`Open original article on ${articleDomain}: ${story.title}`}>
                {articleDomain}
              </a>
              <span class="story-meta-separator" aria-hidden="true">·</span>
            </>
          )}
          {story.source === 'Hacker News' && !story.discussionUrl ? (
            <span>Hacker News</span>
          ) : (
          <a
            class="story-source"
            href={story.source === 'Hacker News' ? story.discussionUrl : story.url}
            target="_blank"
            rel="noreferrer"
            aria-label={story.source === 'Hacker News'
              ? `Open Hacker News discussion for ${story.title}`
              : `Open ${story.source} story: ${story.title}`}
          >
            {story.source}
          </a>
          )}
          {story.relatedSources?.map((related) => (
            <>
              <span class="story-meta-separator" aria-hidden="true">·</span>
              <a class="story-source" href={related.url} target="_blank" rel="noreferrer" aria-label={`Open related coverage from ${related.source}: ${related.title}`}>{related.source}</a>
            </>
          ))}
          {story.source !== 'Hacker News' && story.discussionUrl && (
            <>
              <span class="story-meta-separator" aria-hidden="true">·</span>
              <a class="story-source" href={story.discussionUrl} target="_blank" rel="noreferrer" aria-label={`Open Hacker News discussion for ${story.title}`}>Hacker News</a>
            </>
          )}
        </div>
      </div>
    </CardContent>
  </Card>
</article>

<script>
  import { formatRelativeAge } from '@/content';

  document.querySelectorAll<HTMLTimeElement>('[data-relative-age]').forEach((time) => {
    time.textContent = formatRelativeAge(time.dateTime || null);
  });
</script>
