---
import { Card, CardContent } from '@/components/starwind/card';
import { formatPublicationTimestamp, formatRelativeAge, type Story } from '@/content';

interface Props {
  story: Story;
  referenceDate?: string;
  page: number;
  initiallyHidden?: boolean;
}

const { story, referenceDate, page, initiallyHidden = false } = Astro.props;
const isDiscovery = story.source === 'Hacker News' || story.sourceRole === 'curator' || story.sourceRole === 'community';
let articleDomain: string | null = null;
if (isDiscovery) {
  try {
    const url = new URL(story.url);
    if (url.protocol === 'https:' || url.protocol === 'http:') articleDomain = url.hostname.replace(/^www\./, '');
  } catch { /* A malformed link may not identify a publisher. */ }
}
const showArticleDomain = articleDomain && !['Hacker News', 'Sidebar', 'Slashdot', 'Techmeme'].includes(story.source) && story.category !== 'Discover';
const wallhopSources = new Set([
  'wired',
  'mit technology review',
  'the new yorker',
  'new york magazine',
  'new york magazine (intelligencer)',
  'fast company',
  'vox',
  'publishers weekly',
  'london review of books',
  'south china morning post',
  'scmp',
  'the atlantic',
]);
const wallhopUrl = wallhopSources.has(story.source.trim().toLocaleLowerCase())
  ? `https://wallhop.io/${story.url}`
  : null;
---

<li class="story" data-category={story.category} data-page={page} hidden={initiallyHidden}>
  <article>
    <Card size="sm" class="story-card ring-0">
      <CardContent class="story-content">
        <div class="story-copy">
          <h2 class="story-title story-marker">
            <span class="story-title-text">
              <a href={story.url} target="_blank" rel="noreferrer">{story.title}</a>
              {story.source === 'Hacker News' && story.discussionUrl && (
                <a class="story-source story-discussion story-age" href={story.discussionUrl} target="_blank" rel="noreferrer" aria-label={`Open Hacker News discussion for ${story.title}`}>HN</a>
              )}
              {story.source === 'Waxy' && story.sourceUrl && (
                <a class="story-source story-discussion story-age" href={story.sourceUrl} target="_blank" rel="noreferrer" aria-label={`Open Waxy post for ${story.title}`}>W</a>
              )}
            </span>
            {wallhopUrl ? (
              <a class="story-age" href={wallhopUrl} target="_blank" rel="noreferrer" aria-label={`Open ${story.title} through Wallhop`}>
                <time datetime={story.publishedAt ?? undefined} title={formatPublicationTimestamp(story.publishedAt, referenceDate)} data-relative-age>
                  {formatRelativeAge(story.publishedAt)}
                </time>
              </a>
            ) : (
              <time class="story-age" datetime={story.publishedAt ?? undefined} title={formatPublicationTimestamp(story.publishedAt, referenceDate)} data-relative-age>
                {formatRelativeAge(story.publishedAt)}
              </time>
            )}
          </h2>
          {showArticleDomain && <div class="story-meta">
            {showArticleDomain && <a class="story-source" href={story.url} target="_blank" rel="noreferrer" aria-label={`Open original article on ${articleDomain}: ${story.title}`}>{articleDomain}</a>}
          </div>}
        </div>
      </CardContent>
    </Card>
  </article>
</li>

<script>
  import { formatRelativeAge } from '@/content';

  function updateAges() {
    document.querySelectorAll<HTMLElement>('[data-relative-age]').forEach((time) => {
      time.textContent = formatRelativeAge(time.getAttribute('datetime'));
    });
  }
  updateAges();
  setInterval(updateAges, 60_000);
</script>
