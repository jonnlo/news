---
import Layout from '../../layouts/Layout.astro';
import { formatDate, type Edition } from '../../content';
const files = Object.values(import.meta.glob('../../data/editions/*.json', { eager: true, import: 'default' })) as Edition[];
const editions = files.sort((a, b) => b.date.localeCompare(a.date));
---
<Layout title="Archive" description="Past editions of The Daily Brief.">
  <main class="wrap">
    <header class="masthead"><a class="wordmark" href={import.meta.env.BASE_URL}>THE DAILY BRIEF<span> / PERSONAL EDITION</span></a><a class="archive-link" href={import.meta.env.BASE_URL}>Today <span aria-hidden="true">↗</span></a></header>
    <section class="intro archive-intro"><p class="eyebrow">A record of the read</p><h1>The <em>archive.</em></h1><p class="dek">Every daily edition stays here, with links back to the original publishers.</p></section>
    <section class="archive-list" aria-label="Past editions">
      {editions.map((edition) => <a class="archive-row" href={`${import.meta.env.BASE_URL}edition/${edition.date}/`}><span>{formatDate(edition.date)}</span><span>{edition.stories.length} stories</span><span aria-hidden="true">↗</span></a>)}
    </section>
    <footer class="page-footer"><span>Asia/Hong_Kong edition dates</span><span><a href={import.meta.env.BASE_URL}>Back to today's stories</a></span></footer>
  </main>
</Layout>
