---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { formatDate, type Edition } from '../../content';

const files = Object.values(
  import.meta.glob('../../data/editions/*.json', { eager: true, import: 'default' }),
) as Edition[];
const editions = files.sort((a, b) => b.date.localeCompare(a.date));
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Archive" description="Past editions of The Daily Brief.">
  <SiteHeader active="archive" />
  <main class="page-shell archive-page">
    <section class="page-heading" aria-labelledby="page-title">
      <div>
        <h1 id="page-title">Archive</h1>
        <p class="page-subtitle">Earlier editions, with links to each original story.</p>
      </div>
    </section>

    {editions.length > 0 ? (
      <section class="archive-list" aria-label="Saved editions">
        {editions.map((edition) => (
          <a class="archive-row" href={`${base}edition/${edition.date}/`}>
            <span class="archive-date">{formatDate(edition.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
            <span class="archive-count">{edition.stories.length} {edition.stories.length === 1 ? 'story' : 'stories'}</span>
          </a>
        ))}
      </section>
    ) : (
      <p class="empty-panel">The archive will appear here after the first edition is collected.</p>
    )}

    <footer class="page-footer">
      <span>Dates use Hong Kong time.</span>
      <a href={base}>Back to the latest edition</a>
    </footer>
  </main>
</Layout>
