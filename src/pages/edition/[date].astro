---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import StoryCard from '@/components/StoryCard.astro';
import { formatDate, type Edition } from '../../content';

export function getStaticPaths() {
  const editions = Object.values(
    import.meta.glob('../../data/editions/*.json', { eager: true, import: 'default' }),
  ) as Edition[];
  return editions.map((edition) => ({ params: { date: edition.date }, props: { edition } }));
}

const { edition } = Astro.props as { edition: Edition };
const dateLabel = formatDate(edition.date, {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title={dateLabel} description={`The Daily Brief edition for ${dateLabel}.`}>
  <SiteHeader />
  <main class="page-shell archive-page">
    <section class="page-heading" aria-labelledby="page-title">
      <div>
        <h1 id="page-title">{dateLabel}</h1>
        <p class="page-subtitle">{edition.stories.length} stories from the Hong Kong edition.</p>
      </div>
      <a class="back-link" href={`${base}archive/`}>All editions</a>
    </section>

    <section class="story-list" aria-label={`Stories from ${dateLabel}`}>
      {edition.stories.map((story) => <StoryCard story={story} />)}
    </section>

    <footer class="page-footer">
      <span>Every story opens at its original source.</span>
      <a href={`${base}archive/`}>Back to the archive</a>
    </footer>
  </main>
</Layout>
