---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
// Reference colors supplied from “Recommend Color Palettes”. These are light palettes.
const presets = [
  { id: 'quiet-mineral', name: 'Quiet Mineral', canvas: 'oklch(97.0% 1.0% 157.2)', paper: 'oklch(100.0% 0.0% 0.0)', text: 'oklch(25.1% 4.7% 178.8)', border: 'oklch(89.8% 3.0% 170.2)', accent: 'oklch(53.3% 23.5% 185.2)', secondary: 'oklch(51.5% 5.6% 180.4)' },
  { id: 'chalk-volt', name: 'Chalk & Volt', canvas: 'oklch(97.0% 1.7% 124.5)', paper: 'oklch(100.0% 0.0% 0.0)', text: 'oklch(21.7% 2.1% 153.2)', border: 'oklch(88.2% 3.3% 130.8)', accent: 'oklch(92.9% 54.1% 125.0)', secondary: 'oklch(53.6% 3.9% 145.3)' },
  { id: 'cobalt-ledger', name: 'Cobalt Ledger', canvas: 'oklch(96.6% 1.9% 260.7)', paper: 'oklch(100.0% 0.0% 0.0)', text: 'oklch(22.7% 9.0% 262.5)', border: 'oklch(87.3% 5.5% 256.7)', accent: 'oklch(54.6% 62.8% 265.0)', secondary: 'oklch(54.2% 9.6% 259.4)' },
  { id: 'pure-monochrome', name: 'Pure Monochrome', canvas: 'oklch(94.8% 0.6% 228.8)', paper: 'oklch(100.0% 0.0% 0.0)', text: 'oklch(20.4% 1.1% 264.5)', border: 'oklch(81.3% 1.6% 255.5)', accent: 'oklch(31.7% 1.9% 264.5)', secondary: 'oklch(51.1% 2.5% 248.0)' },
];
const palettes = {
  light: {
    label: 'Light palette',
    tokens: [
      { key: '--theme-accent', label: 'Theme accent', original: 'oklch(46.3% 15.7% 338.1)', group: 'Accent' },
      { key: '--theme-accent-text', label: 'Accent text', original: 'oklch(46.3% 15.7% 338.1)', group: 'Accent' },
      { key: '--theme-accent-foreground', label: 'On accent', original: 'oklch(100.0% 0.0% 0.0)', group: 'Accent' },
      { key: '--ground', label: 'Ground', original: 'oklch(95.0% 0.8% 230.0)', group: 'Background' },
      { key: '--surface', label: 'Surface', original: 'oklch(100.0% 0.0% 0.0)', group: 'Background' },
      { key: '--raised', label: 'Raised', original: 'oklch(91.9% 0.0% 0.0)', group: 'Background' },
      { key: '--rule', label: 'Rule', original: 'oklch(86.4% 0.0% 0.0)', group: 'Background' },
      { key: '--text', label: 'Text / controls', original: 'oklch(24.4% 0.0% 0.0)', group: 'Text' },
      { key: '--muted-copy', label: 'Secondary text', original: 'oklch(47.8% 0.0% 0.0)', group: 'Text' },
      { key: '--faint-copy', label: 'Faint text', original: 'oklch(55.6% 0.0% 0.0)', group: 'Text' },
      { key: '--wordmark-copy', label: 'Wordmark', original: 'oklch(43.1% 0.0% 0.0)', group: 'Text' },
    ],
  },
  dark: {
    label: 'Dark palette',
    tokens: [
      { key: '--theme-accent', label: 'Theme accent', original: 'oklch(46.3% 15.7% 338.1)', group: 'Accent' },
      { key: '--theme-accent-text', label: 'Accent text', original: 'oklch(73.8% 12.6% 343.9)', group: 'Accent' },
      { key: '--theme-accent-foreground', label: 'On accent', original: 'oklch(100.0% 0.0% 0.0)', group: 'Accent' },
      { key: '--ground', label: 'Ground', original: 'oklch(16.0% 0.8% 230.0)', group: 'Background' },
      { key: '--surface', label: 'Surface', original: 'oklch(21.6% 1.5% 121.9)', group: 'Background' },
      { key: '--raised', label: 'Raised', original: 'oklch(26.6% 1.9% 118.3)', group: 'Background' },
      { key: '--rule', label: 'Rule', original: 'oklch(32.6% 2.6% 114.7)', group: 'Background' },
      { key: '--text', label: 'Text / controls', original: 'oklch(96.7% 1.7% 97.3)', group: 'Text' },
      { key: '--muted-copy', label: 'Secondary text', original: 'oklch(80.3% 2.8% 100.9)', group: 'Text' },
      { key: '--faint-copy', label: 'Faint text', original: 'oklch(68.8% 2.9% 100.9)', group: 'Text' },
      { key: '--wordmark-copy', label: 'Wordmark', original: 'oklch(73.4% 2.5% 100.0)', group: 'Text' },
    ],
  },
};
---

<Layout title="Color experiment – One More Tab" description="Explore the news digest color tokens against the real latest edition.">
  <main class="experiment-shell" data-palettes={JSON.stringify(palettes)} data-home={base} data-presets={JSON.stringify(presets)}>
    <header class="experiment-header">
      <div class="experiment-heading">
        <a href={base} class="back-link">← One More Tab</a>
        <h1>Color experiment</h1>
        <p>Adjust the real theme tokens against today’s headlines.</p>
      </div>
    </header>

    <div class="experiment-workspace">
      <aside class="tuner-panel" aria-label="Color controls">
        <div class="palette-switch" role="group" aria-label="Choose a palette">
          <button type="button" data-palette="light" aria-pressed="true">Light</button>
          <button type="button" data-palette="dark" aria-pressed="false">Dark</button>
        </div>
        <fieldset class="preset-picker">
          <legend>Light palette presets</legend>
          <div class="preset-list">
            {presets.map((preset) => (
              <button type="button" data-preset={preset.id} aria-pressed="false" disabled>
                <span class="preset-swatches" aria-hidden="true">
                  {[preset.canvas, preset.paper, preset.text, preset.border, preset.accent].map((color) => <span style={`background:${color}`}></span>)}
                </span>
                <span>{preset.name}</span>
              </button>
            ))}
          </div>
        </fieldset>
        <div class="token-heading">
          <div><h2 id="palette-title">Light palette</h2><p>OKLCH · lightness, chroma, hue</p></div>
          <button id="reset-all" class="text-button" type="button">Reset all</button>
        </div>
        <div id="token-controls" class="token-controls"></div>
        <div class="export-controls">
          <label for="css-output">Selected palette CSS</label>
          <textarea id="css-output" rows="5" readonly spellcheck="false"></textarea>
          <div class="export-actions">
            <button id="copy-css" class="quiet-button" type="button">Copy CSS</button>
            <button id="download-css" class="quiet-button" type="button">Download CSS</button>
          </div>
          <p id="experiment-status" role="status" aria-live="polite">Edits are previewed in this page only.</p>
        </div>
      </aside>

      <section class="preview-panel" aria-label="Live news page preview">
        <div class="preview-toolbar">
          <div class="preview-label"><span class="live-dot" aria-hidden="true"></span><span>Latest edition</span><span class="preview-date">Live page preview</span></div>
          <div class="preview-options">
            <div class="preview-mode" role="group" aria-label="Show preview colors">
              <button type="button" data-preview="tuned" aria-pressed="true">Tuned</button>
              <button type="button" data-preview="original" aria-pressed="false">Original</button>
            </div>
            <button id="preview-width" class="text-button" type="button" aria-pressed="false">Narrow preview</button>
            <button id="focus-preview" class="quiet-button" type="button" aria-pressed="false">Focus preview</button>
          </div>
        </div>
        <div class="preview-frame-wrap">
          <iframe title="One More Tab latest headlines with experimental colors" src={base} loading="eager"></iframe>
        </div>
      </section>
    </div>
  </main>

  <script>
    type Token = { key: string; label: string; original: string; group: string };
    type Preset = { id: string; name: string; canvas: string; paper: string; text: string; border: string; accent: string; secondary: string };
    type Palette = { label: string; tokens: Token[] };
    const shell = document.querySelector<HTMLElement>('.experiment-shell')!;
    const palettes = JSON.parse(shell.dataset.palettes ?? '{}') as Record<'light' | 'dark', Palette>;
    const presets = JSON.parse(shell.dataset.presets ?? '[]') as Preset[];
    const selectedPresets: Record<'light' | 'dark', string | null> = { light: null, dark: null };
    const iframe = document.querySelector<HTMLIFrameElement>('.preview-frame-wrap iframe')!;
    const controls = document.querySelector<HTMLElement>('#token-controls')!;
    const cssOutput = document.querySelector<HTMLTextAreaElement>('#css-output')!;
    const status = document.querySelector<HTMLElement>('#experiment-status')!;
    const paletteTitle = document.querySelector<HTMLElement>('#palette-title')!;
    const state: Record<'light' | 'dark', Record<string, { l: number; c: number; h: number; value: string }>> = { light: {}, dark: {} };
    let activePalette: 'light' | 'dark' = 'light';
    let previewOriginal = false;

    function normalizeHex(color: string) {
      if (color.startsWith('#')) {
        const hex = color.slice(1);
        if (/^[\da-f]{3}$/i.test(hex)) return `#${[...hex].map((digit) => `${digit}${digit}`).join('')}`;
        if (/^[\da-f]{4}$/i.test(hex)) return `#${[...hex.slice(0, 3)].map((digit) => `${digit}${digit}`).join('')}`;
        if (/^[\da-f]{6}$/i.test(hex)) return `#${hex}`;
        if (/^[\da-f]{8}$/i.test(hex)) return `#${hex.slice(0, 6)}`;
      }
      const values = color.match(/[\d.]+/g)?.slice(0, 3).map(Number);
      if (!values || values.length < 3) return '#000000';
      return `#${values.map((value) => Math.round(value).toString(16).padStart(2, '0')).join('')}`;
    }

    function rgbToOklch(color: string) {
      const oklch = color.match(/^oklch\(\s*([\d.]+)(%)?\s+([\d.]+)(%)?\s+([\d.]+)(?:deg)?\s*\)$/i);
      if (oklch) return {
        l: Number(oklch[1]) * (oklch[2] ? 1 : 100),
        c: Number(oklch[3]) * (oklch[4] ? 0.4 : 100),
        h: Number(oklch[5]),
      };
      const hex = normalizeHex(color);
      const raw = hex.replace('#', '');
      const rgb = [0, 2, 4].map((i) => parseInt(raw.slice(i, i + 2), 16) / 255).map((v) => v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
      const [r, g, b] = rgb;
      const l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
      const m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
      const s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
      const ll = Math.cbrt(l), mm = Math.cbrt(m), ss = Math.cbrt(s);
      const L = 0.2104542553 * ll + 0.793617785 * mm - 0.0040720468 * ss;
      const a = 1.9779984951 * ll - 2.428592205 * mm + 0.4505937099 * ss;
      const bb = 0.0259040371 * ll + 0.7827717662 * mm - 0.808675766 * ss;
      return { l: L * 100, c: Math.hypot(a, bb) * 100, h: (Math.atan2(bb, a) * 180 / Math.PI + 360) % 360 };
    }

    function formatColor(value: { l: number; c: number; h: number }) {
      return `oklch(${value.l.toFixed(1)}% ${(value.c / 0.4).toFixed(1)}% ${value.h.toFixed(1)})`;
    }

    function ensureState() {
      for (const mode of ['light', 'dark'] as const) {
        for (const token of palettes[mode].tokens) {
          state[mode][token.key] = { ...rgbToOklch(token.original), value: token.original };
        }
      }
    }

    function renderControls() {
      const palette = palettes[activePalette];
      paletteTitle.textContent = palette.label;
      const groups = ['Accent', 'Background', 'Text'];
      syncPresetSelection();
      controls.innerHTML = groups.map((group) => `<section class="token-group" aria-label="${group} tokens"><h3>${group}</h3>${palette.tokens.filter((token) => token.group === group).map((token) => {
        const current = state[activePalette][token.key];
        const id = `${activePalette}-${token.key.replace(/[^a-z]/gi, '')}`;
        return `<article class="token-row" data-token="${token.key}">
          <div class="token-topline"><div class="token-name"><span class="swatch" style="--swatch:${current.value}"></span><label for="${id}-l">${token.label}</label></div><code>${current.value}</code><button class="reset-token" type="button" data-reset-token="${token.key}" aria-label="Reset ${token.label} to original">Reset</button></div>
          <div class="channel-row"><label for="${id}-l">L</label><input type="number" min="0" max="100" step="0.1" value="${current.l.toFixed(1)}" data-channel="l" data-key="${token.key}" aria-label="${token.label} lightness value" inputmode="decimal"><input id="${id}-l" type="range" min="0" max="100" step="0.1" value="${current.l}" data-channel="l" data-key="${token.key}" aria-label="${token.label} lightness"></div>
          <div class="channel-row"><label for="${id}-c">C</label><input type="number" min="0" max="37" step="0.1" value="${current.c.toFixed(1)}" data-channel="c" data-key="${token.key}" aria-label="${token.label} chroma value" inputmode="decimal"><input id="${id}-c" type="range" min="0" max="37" step="0.1" value="${current.c}" data-channel="c" data-key="${token.key}" aria-label="${token.label} chroma"></div>
          <div class="channel-row"><label for="${id}-h">H</label><input type="number" min="0" max="360" step="1" value="${Math.round(current.h)}" data-channel="h" data-key="${token.key}" aria-label="${token.label} hue value" inputmode="numeric"><input id="${id}-h" type="range" min="0" max="360" step="1" value="${current.h}" data-channel="h" data-key="${token.key}" aria-label="${token.label} hue"></div>
        </article>`;
      }).join('')}</section>`).join('');

      controls.querySelectorAll<HTMLInputElement>('input[type="range"], input[type="number"]').forEach((input) => {
        const updateChannel = (finalize = false) => {
          const channel = input.dataset.channel as 'l' | 'c' | 'h';
          const tokenState = state[activePalette][input.dataset.key!];
          const raw = input.valueAsNumber;
          if (!Number.isFinite(raw)) {
            if (finalize) input.value = String(tokenState[channel]);
            return;
          }
          const min = Number(input.min), max = Number(input.max), step = Number(input.step);
          const bounded = Math.min(max, Math.max(min, raw));
          const value = Number((Math.round((bounded - min) / step) * step + min).toFixed(channel === 'h' ? 0 : 1));
          selectedPresets[activePalette] = null;
          showTuned();
          syncPresetSelection();
          tokenState[channel] = value;
          tokenState.value = formatColor(tokenState);
          const row = input.closest<HTMLElement>('.token-row')!;
          row.querySelector('.swatch')?.setAttribute('style', `--swatch:${tokenState.value}`);
          row.querySelector('code')!.textContent = tokenState.value;
          row.querySelectorAll<HTMLInputElement>(`input[data-channel="${channel}"]`).forEach((peer) => {
            if (peer !== input) peer.value = String(value);
          });
          if (finalize) input.value = String(value);
          updatePreview();
        };
        input.addEventListener('input', () => updateChannel());
        input.addEventListener('change', () => updateChannel(true));
      });
      controls.querySelectorAll<HTMLButtonElement>('[data-reset-token]').forEach((button) => button.addEventListener('click', () => {
        selectedPresets[activePalette] = null;
        const token = palette.tokens.find((item) => item.key === button.dataset.resetToken)!;
        state[activePalette][token.key] = { ...rgbToOklch(token.original), value: token.original };
        previewOriginal = false;
        document.querySelectorAll('[data-preview]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab.getAttribute('data-preview') === 'tuned')));
        renderControls(); updatePreview();
      }));
      updateCss();
    }

    function syncPresetSelection() {
      document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => {
        button.setAttribute('aria-pressed', String(activePalette === 'light' && selectedPresets.light === button.dataset.preset));
      });
    }

    function showTuned() {
      previewOriginal = false;
      document.querySelectorAll('[data-preview]').forEach((button) => button.setAttribute('aria-pressed', String(button.getAttribute('data-preview') === 'tuned')));
    }

    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', () => {
      const preset = presets.find((item) => item.id === button.dataset.preset)!;
      activePalette = 'light';
      const volt = preset.id === 'chalk-volt';
      // No extra reference was supplied for Raised: use the reference canvas.
      // Bright lime is a fill/indicator; use the reference ink for readable accent text.
      const values: Record<string, string> = {
        '--ground': preset.canvas, '--surface': preset.paper, '--raised': preset.canvas,
        '--rule': preset.border, '--theme-accent': preset.accent,
        '--theme-accent-text': volt ? preset.text : preset.accent,
        '--theme-accent-foreground': volt ? preset.text : preset.paper,
        '--text': preset.text, '--wordmark-copy': preset.text,
        '--muted-copy': preset.secondary, '--faint-copy': preset.secondary,
      };
      for (const token of palettes.light.tokens) {
        const value = values[token.key];
        state.light[token.key] = { ...rgbToOklch(value), value };
      }
      selectedPresets.light = preset.id;
      document.querySelectorAll('[data-palette]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab.getAttribute('data-palette') === 'light')));
      showTuned(); renderControls(); updatePreview();
      status.textContent = `${preset.name} applied to the light palette.`;
    }));

    function updateCss() {
      const palette = palettes[activePalette];
      cssOutput.value = `html${activePalette === 'dark' ? '.dark' : ''} {\n${palette.tokens.map((token) => {
        const value = activePalette === 'light' && token.key === '--theme-accent-text'
          && state.light[token.key].value === token.original
          ? 'var(--theme-accent)'
          : state[activePalette][token.key].value;
        return `  ${token.key}: ${value};`;
      }).join('\n')}\n}`;
    }

    function updatePreview() {
      const doc = iframe.contentDocument;
      if (!doc) return;
      const root = doc.documentElement;
      const mode = activePalette;
      root.classList.toggle('dark', mode === 'dark');
      root.style.colorScheme = mode;
      for (const palette of ['light', 'dark'] as const) {
        for (const token of palettes[palette].tokens) root.style.removeProperty(token.key);
      }
      if (!previewOriginal) for (const token of palettes[activePalette].tokens) {
        const lightAlias = activePalette === 'light' && token.key === '--theme-accent-text'
          && state.light[token.key].value === token.original;
        if (!lightAlias) root.style.setProperty(token.key, state[activePalette][token.key].value);
      }
      updateCss();
    }

    let initialized = false;
    const previewUrl = new URL(shell.dataset.home ?? '/', window.location.href);
    const initializeFromRenderedSite = () => {
      const doc = iframe.contentDocument;
      if (!doc) return;
      // The browser creates a completed about:blank document before the iframe's
      // requested homepage loads. Wait until the actual same-origin home document.
      try {
        if (doc.location.origin !== window.location.origin || doc.location.pathname !== previewUrl.pathname) return;
      } catch { return; }
      const root = doc.documentElement;
      if (!root || doc.readyState !== 'complete') return;
      if (initialized) {
        updatePreview();
        return;
      }
      initialized = true;
      root.classList.remove('dark');
      root.style.colorScheme = 'light';
      const lightValues = getComputedStyle(root);
      for (const token of palettes.light.tokens) {
        const value = lightValues.getPropertyValue(token.key).trim();
        token.original = value.startsWith('oklch(') ? value : normalizeHex(value);
      }
      root.classList.add('dark');
      const darkValues = getComputedStyle(root);
      for (const token of palettes.dark.tokens) {
        const value = darkValues.getPropertyValue(token.key).trim();
        token.original = value.startsWith('oklch(') ? value : normalizeHex(value);
      }
      root.classList.remove('dark');
      ensureState();
      document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => { button.disabled = false; });
      renderControls();
      updatePreview();
    };
    iframe.addEventListener('load', initializeFromRenderedSite);
    if (iframe.contentDocument?.readyState === 'complete') initializeFromRenderedSite();
    document.querySelectorAll<HTMLButtonElement>('[data-palette]').forEach((button) => button.addEventListener('click', () => {
      activePalette = button.dataset.palette as 'light' | 'dark';
      document.querySelectorAll('[data-palette]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab === button)));
      previewOriginal = false;
      document.querySelectorAll('[data-preview]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.preview === 'tuned')));
      renderControls(); updatePreview();
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((button) => button.addEventListener('click', () => {
      previewOriginal = button.dataset.preview === 'original';
      document.querySelectorAll('[data-preview]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab === button)));
      updatePreview(); status.textContent = previewOriginal ? 'Showing the original token values.' : 'Showing your tuned token values.';
    }));
    document.querySelector<HTMLButtonElement>('#reset-all')!.addEventListener('click', () => {
      selectedPresets[activePalette] = null;
      for (const token of palettes[activePalette].tokens) state[activePalette][token.key] = { ...rgbToOklch(token.original), value: token.original };
      renderControls(); previewOriginal = false;
      document.querySelectorAll('[data-preview]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab.getAttribute('data-preview') === 'tuned')));
      updatePreview(); status.textContent = `${palettes[activePalette].label} reset to the original values.`;
    });
    document.querySelector<HTMLButtonElement>('#preview-width')!.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const narrow = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(narrow)); button.textContent = narrow ? 'Full width' : 'Narrow preview';
      document.querySelector('.preview-frame-wrap')!.classList.toggle('narrow', narrow);
    });
    document.querySelector<HTMLButtonElement>('#focus-preview')!.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const focused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(focused)); button.textContent = focused ? 'Show controls' : 'Focus preview';
      document.querySelector('.experiment-workspace')!.classList.toggle('preview-focus', focused);
      document.querySelector('.experiment-shell')!.classList.toggle('focus-mode', focused);
    });
    document.querySelector<HTMLButtonElement>('#copy-css')!.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(cssOutput.value); status.textContent = 'CSS copied to clipboard.'; }
      catch { cssOutput.select(); document.execCommand('copy'); status.textContent = 'CSS copied to clipboard.'; }
    });
    document.querySelector<HTMLButtonElement>('#download-css')!.addEventListener('click', () => {
      const url = URL.createObjectURL(new Blob([cssOutput.value], { type: 'text/css' }));
      const link = document.createElement('a'); link.href = url; link.download = `one-more-tab-${activePalette}-tokens.css`; link.click(); URL.revokeObjectURL(url);
      status.textContent = 'CSS file downloaded.';
    });
  </script>

  <style>
    .experiment-shell { width: min(1760px, calc(100% - 48px)); margin: 0 auto; padding: 24px 0 48px; }
    .experiment-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding: 14px 0 24px; border-bottom: 1px solid var(--rule); }
    .experiment-heading h1 { margin: 10px 0 2px; font-size: 25px; line-height: 1.2; font-weight: 600; letter-spacing: -0.025em; }
