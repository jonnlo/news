---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Button } from '@/components/starwind/button';
import StoryCard from '@/components/StoryCard.astro';
import { categories, formatDate, formatHongKongTime, type Edition, type SourceCollection } from '../content';
import newsSettings from '../data/news-settings.json';

const homepageOverrides: Record<string, string> = {
  '香港01': 'https://www.hk01.com/',
  'Now 新聞': 'https://news.now.com/home/local',
  'Ars Technica': 'https://arstechnica.com/',
  'Hacker News': 'https://news.ycombinator.com/',
  'Kottke': 'https://kottke.org/',
  'MetaFilter': 'https://www.metafilter.com/',
  'It’s Nice That': 'https://www.itsnicethat.com/',
  'AP via Flipboard': 'https://apnews.com/',
  'MUBI Notebook': 'https://mubi.com/notebook/',
  'Reuters via Google News': 'https://www.reuters.com/',
  'The Sociological Review': 'https://www.thesociologicalreview.org/',
  'The Rumpus': 'https://therumpus.net/',
};
const activeSources = newsSettings.categories
  .filter((category) => category.enabled && categories.includes(category.name))
  .flatMap((category) => category.sources
    .filter((source) => source.enabled)
    .map((source) => ({ ...source, category: category.name })));
const homepages = new Map(activeSources.map((source) => [source.name, homepageOverrides[source.name] ?? new URL(source.url).origin]));
const sourceOrder = new Map(activeSources.map((source, index) => [source.name, index] as const));
const sourceCategory = new Map(activeSources.map((source) => [source.name, source.category] as const));

const allEditions = Object.values(
  import.meta.glob('../data/editions/*.json', { eager: true, import: 'default' }),
) as Edition[];
const edition = allEditions.sort((a, b) => b.date.localeCompare(a.date))[0];
const stories = edition?.stories ?? [];
const sourceGroups: SourceCollection[] = edition?.sources?.length
  ? edition.sources
  : [...new Set(stories.map((story) => `${story.source}\u0000${story.category}`))].map((key) => {
    const [source, category] = key.split('\u0000');
    const sourceStories = stories.filter((story) => story.source === source && story.category === category);
    return { name: source, category: (category ?? 'Discover') as SourceCollection['category'], stories: sourceStories };
  });
sourceGroups.forEach((group) => {
  group.category = sourceCategory.get(group.name) ?? group.category;
});
sourceGroups.forEach((group) => {
  if (group.kind === 'hackernews' || group.name === 'Hacker News') return;
  group.stories.sort((a, b) => {
    const timeA = a.publishedAt ? Date.parse(a.publishedAt) : Number.NEGATIVE_INFINITY;
    const timeB = b.publishedAt ? Date.parse(b.publishedAt) : Number.NEGATIVE_INFINITY;
    return (Number.isNaN(timeB) ? Number.NEGATIVE_INFINITY : timeB) -
      (Number.isNaN(timeA) ? Number.NEGATIVE_INFINITY : timeA);
  });
});
sourceGroups.forEach((group) => {
  group.stories = group.stories.slice(0, 20);
});
sourceGroups.sort((a, b) =>
  categories.indexOf(a.category) - categories.indexOf(b.category) ||
  (sourceOrder.get(a.name) ?? Number.POSITIVE_INFINITY) - (sourceOrder.get(b.name) ?? Number.POSITIVE_INFINITY),
);
const collectionTime = edition ? formatHongKongTime(edition.generatedAt) : null;
---

<Layout title="One More Tab – Links Worth Opening" description="Links worth opening. A collection of stories, ideas, and discoveries from across the web.">
  <SiteHeader active="latest" />
  <main class="page-shell latest-page">
    <section class="latest-heading" aria-label="Collection status">
      <h1 class="edition-stamp">{edition && collectionTime
        ? `${edition.collectionMode === 'source-led' ? 'Updated' : 'Curated'} ${formatDate(edition.generatedAt, { day: 'numeric', month: 'short' })}, ${collectionTime} HKT`
        : 'Waiting for first collection'}</h1>
    </section>

    {edition && sourceGroups.length > 0 ? (
      <>
        <nav class="topic-bar" aria-label="Filter headlines by topic">
          <div class="filters">
            <Button variant="ghost" class="filter active" data-filter="All" aria-pressed="true" aria-controls="source-list">
              <span>All</span>
            </Button>
            {categories.map((category) => (
              <Button
                variant="ghost"
                class="filter"
                data-filter={category}
                aria-pressed="false"
                aria-controls="source-list"
              >
                <span>{category === 'Technology' ? 'Tech' : category}</span>
              </Button>
            ))}
          </div>
        </nav>

        <section class="source-list" id="source-list" aria-label="Latest headlines by source">
          {sourceGroups.filter((group) => sourceOrder.has(group.name) && group.stories.length > 0).map((group, groupIndex) => (
            <section class="source-group" data-category={group.category} data-page="1" aria-label={`${group.name} headlines`}>
              <header class="source-heading">
                <div class="source-name-line">
                  <h2>{homepages.has(group.name)
                    ? <a href={homepages.get(group.name)} target="_blank" rel="noreferrer">{group.name}</a>
                    : group.name}</h2>
                </div>
                {group.stories.length > 10 && (
                  <nav class="source-pager" aria-label={`Pages of ${group.name} headlines`}>
                    {[1, 2].map((page) => (
                      <button
                        class:list={["source-page-button", page === 1 && "active"]}
                        type="button"
                        data-page={page}
                        aria-label={`Show stories 11–20 of ${group.name} headlines`}
                        aria-controls={`stories-${groupIndex}`}
                        aria-current={page === 1 ? 'page' : undefined}
                        aria-pressed={page === 1 ? 'true' : 'false'}
                      ><span class="source-page-segment" aria-hidden="true"></span></button>
                    ))}
                  </nav>
                )}
              </header>
              <ul class="story-list" id={`stories-${groupIndex}`} role="list">
                {group.stories.map((story, storyIndex) => (
                  <StoryCard story={story} referenceDate={edition?.date} page={Math.floor(storyIndex / 10) + 1} initiallyHidden={storyIndex >= 10} />
                ))}
              </ul>
            </section>
          ))}
          <p class="empty-state" hidden>No headlines in this topic for this collection.</p>
        </section>
      </>
    ) : edition ? (
      <section class="empty-panel" aria-live="polite">
        <h2>No headlines collected</h2>
        <p>The latest collection checked {edition.sourcesChecked} sources but found no publishable stories.</p>
      </section>
    ) : (
      <section class="empty-panel first-run" aria-live="polite">
        <h2>Waiting for the first collection</h2>
        <p>When the collector runs, headlines will appear here grouped by source and ordered by publication time.</p>
      </section>
    )}

    <footer class="page-footer">
      <span>Headlines link to their original publishers.</span>
      <span>{edition ? `${edition.sourcesChecked} sources checked` : 'No collection has run yet'}</span>
    </footer>
  </main>

  <script>
    const topicBar = document.querySelector<HTMLElement>('.topic-bar');
    const mobile = window.matchMedia('(max-width: 640px)');
    const stickyBar = topicBar?.cloneNode(true) as HTMLElement | undefined;
    if (stickyBar && topicBar) {
      stickyBar.classList.add('sticky-topic-bar');
      stickyBar.hidden = true;
      document.body.append(stickyBar);
    }
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const groups = [...document.querySelectorAll<HTMLElement>('.source-group')];
    const empty = document.querySelector<HTMLElement>('.empty-state');
    let selectedTopic = 'All';

    function setStickyVisible(visible: boolean) {
      if (!stickyBar) return;
      stickyBar.hidden = false;
      stickyBar.classList.toggle('is-visible', visible);
      stickyBar.inert = !visible;
      if (visible) updateScrollTopic();
    }

    function syncStickyVisibility() {
      if (!stickyBar || !topicBar) return;
      const visible = mobile.matches && topicBar.getBoundingClientRect().bottom <= 0;
      if (stickyBar.hidden || stickyBar.classList.contains('is-visible') !== visible) {
        setStickyVisible(visible);
      }
    }

    function revealActiveChip() {
      const row = stickyBar?.querySelector<HTMLElement>('.filters');
      const active = stickyBar?.querySelector<HTMLElement>('.filter.active');
      if (!row || !active) return;
      const rowRect = row.getBoundingClientRect();
      const chipRect = active.getBoundingClientRect();
      const inset = 16;
      if (chipRect.left < rowRect.left + inset) row.scrollLeft += chipRect.left - rowRect.left - inset;
      else if (chipRect.right > rowRect.right - inset) row.scrollLeft += chipRect.right - rowRect.right + inset;
    }

    function updateScrollTopic() {
      if (!stickyBar || !stickyBar.classList.contains('is-visible')) return;
      const visible = groups.filter((group) => !group.hidden);
      const threshold = stickyBar.getBoundingClientRect().height + 12;
      let current = visible[0];
      for (const group of visible) {
        if (group.getBoundingClientRect().top > threshold) break;
        current = group;
      }
      const topic = current?.dataset.category ?? selectedTopic;
      stickyBar.querySelectorAll<HTMLButtonElement>('.filter').forEach((filter) => {
        const active = filter.dataset.filter === topic;
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      revealActiveChip();
    }

    function topicFromUrl() {
      const requested = new URLSearchParams(window.location.search).get('category');
      return filters.some((filter) => filter.dataset.filter === requested) ? requested! : 'All';
    }

    function updateGroups() {
      let matching = 0;
      groups.forEach((group) => {
        const matches = selectedTopic === 'All' || group.dataset.category === selectedTopic;
        group.hidden = !matches;
        if (matches) matching += 1;
      });
      if (empty) empty.hidden = matching > 0;
    }

    function selectTopic(topic: string, updateUrl: boolean) {
      const button = filters.find((filter) => filter.dataset.filter === topic)
        ?? filters.find((filter) => filter.dataset.filter === 'All');
      if (!button) return;
      const nextTopic = button.dataset.filter ?? 'All';
      if (nextTopic !== selectedTopic) resetGroupPages();
      selectedTopic = nextTopic;

      if (updateUrl && selectedTopic !== topicFromUrl()) {
        const url = new URL(window.location.href);
        if (selectedTopic === 'All') url.searchParams.delete('category');
        else url.searchParams.set('category', selectedTopic);
        window.history.pushState({}, '', url);
      }

      filters.forEach((filter) => {
        const active = filter.dataset.filter === selectedTopic;
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      updateGroups();
      if (stickyBar?.classList.contains('is-visible')) updateScrollTopic();
    }

    function setGroupPage(group: HTMLElement, page: number) {
      const nextPage = page === 2 && group.querySelectorAll<HTMLElement>('.story[data-page="2"]').length > 0 ? 2 : 1;
      group.dataset.page = String(nextPage);
      group.querySelectorAll<HTMLElement>('.story').forEach((story) => {
        story.hidden = Number(story.dataset.page) !== nextPage;
      });
      group.querySelectorAll<HTMLButtonElement>('.source-page-button').forEach((button) => {
        const active = Number(button.dataset.page) === nextPage;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
        button.setAttribute('aria-label', `Show stories ${nextPage === 1 ? '11–20' : '1–10'} of ${group.getAttribute('aria-label') ?? 'headlines'}`);
        if (active) button.setAttribute('aria-current', 'page');
        else button.removeAttribute('aria-current');
      });
    }

    function resetGroupPages() {
      groups.forEach((group) => setGroupPage(group, 1));
    }

    groups.forEach((group) => {
      group.querySelectorAll<HTMLButtonElement>('.source-page-button').forEach((button) => {
        button.addEventListener('click', () => setGroupPage(group, group.dataset.page === '1' ? 2 : 1));
      });
    });

    filters.forEach((button) => button.addEventListener('click', () => {
      const topic = button.dataset.filter ?? 'All';
      if (!stickyBar?.contains(button)) {
        selectTopic(topic, true);
        return;
      }
      selectTopic(topic, true);
      const target = groups.find((group) => !group.hidden);
      if (target) {
        const top = target.getBoundingClientRect().top + window.scrollY - stickyBar.offsetHeight - 8;
        window.scrollTo({ top, behavior: 'instant' });
        updateScrollTopic();
      }
    }));
    let scrollPending = false;
    window.addEventListener('scroll', () => {
      if (scrollPending) return;
      scrollPending = true;
      requestAnimationFrame(() => {
        scrollPending = false;
        syncStickyVisibility();
        updateScrollTopic();
      });
    }, { passive: true });
    mobile.addEventListener('change', syncStickyVisibility);
    window.addEventListener('resize', syncStickyVisibility);
    window.addEventListener('popstate', () => selectTopic(topicFromUrl(), false));
    selectTopic(topicFromUrl(), false);
    syncStickyVisibility();
  </script>
</Layout>
