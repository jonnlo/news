---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Button } from '@/components/starwind/button';
import StoryCard from '@/components/StoryCard.astro';
import { categories, type Edition } from '../content';

const allEditions = Object.values(
  import.meta.glob('../data/editions/*.json', { eager: true, import: 'default' }),
) as Edition[];
const edition = allEditions.sort((a, b) => b.date.localeCompare(a.date))[0];
const stories = edition?.stories ?? [];
const counts = Object.fromEntries(
  categories.map((category) => [category, stories.filter((story) => story.category === category).length]),
);
const editionDate = edition
  ? new Intl.DateTimeFormat('en-HK', {
    weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Asia/Hong_Kong',
  }).format(new Date(edition.date))
  : 'No edition has been collected yet';
---

<Layout title={editionDate} description="A personal daily reading list across technology, design, Hong Kong, society, philosophy, literature and arts.">
  <SiteHeader active="latest" />
  <main class="page-shell reader">
    <section class="page-heading" aria-labelledby="page-title">
      <h1 id="page-title">{editionDate}</h1>
    </section>

    {edition && stories.length > 0 ? (
      <>
        <nav class="filters" aria-label="Filter stories by topic">
          {categories.map((category) => (
            <Button
              variant="ghost"
              class={category === 'Technology' ? 'filter active' : 'filter'}
              data-filter={category}
              aria-pressed={category === 'Technology' ? 'true' : 'false'}
              aria-controls="story-list"
            >
              <span>{category}</span><span class="filter-count">{counts[category]}</span>
            </Button>
          ))}
        </nav>

        <section class="stories-section" aria-label="News stories">
          <div class="story-list" id="story-list">
            {stories.map((story) => <StoryCard story={story} />)}
          </div>
          <p class="empty-state" hidden>No stories in this topic for this edition.</p>
        </section>
      </>
    ) : (
      <section class="empty-panel" aria-live="polite">
        <h2>No edition yet</h2>
        <p>The reading list will appear here after the first collection run.</p>
      </section>
    )}

    <footer class="page-footer">
      <span>Every story opens at its original source.</span>
      <span>Collected without AI summaries or tracking.</span>
    </footer>
  </main>

  <script>
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const stories = [...document.querySelectorAll<HTMLElement>('.story')];
    const empty = document.querySelector<HTMLElement>('.empty-state');
    let selectedTopic = 'Technology';

    function updateStories() {
      let matching = 0;
      stories.forEach((story) => {
        const matches = story.dataset.category === selectedTopic;
        story.hidden = !matches;
        if (matches) matching += 1;
      });

      if (empty) empty.hidden = matching > 0;
    }

    filters.forEach((button) => button.addEventListener('click', () => {
      selectedTopic = button.dataset.filter ?? 'Technology';
      filters.forEach((filter) => {
        const active = filter === button;
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      updateStories();
    }));

    updateStories();
  </script>
</Layout>
