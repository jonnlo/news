---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Button } from '@/components/starwind/button';
import StoryCard from '@/components/StoryCard.astro';
import { categories, formatDate, formatHongKongTime, type Edition, type SourceCollection } from '../content';
import newsSettings from '../data/news-settings.json';
import SourceNavigator from '../components/SourceNavigator.astro';

const homepageOverrides: Record<string, string> = {
  '香港01': 'https://www.hk01.com/',
  'Now 新聞': 'https://news.now.com/home/local',
  'Ars Technica': 'https://arstechnica.com/',
  'Hacker News': 'https://news.ycombinator.com/',
  'Kottke': 'https://kottke.org/',
  'MetaFilter': 'https://www.metafilter.com/',
  'It’s Nice That': 'https://www.itsnicethat.com/',
  'AP via Flipboard': 'https://apnews.com/',
  'MUBI Notebook': 'https://mubi.com/notebook/',
  'Reuters': 'https://www.reuters.com/',
  'The Sociological Review': 'https://www.thesociologicalreview.org/',
  'The Rumpus': 'https://therumpus.net/',
};
const activeSources = newsSettings.categories
  .filter((category) => category.enabled && categories.includes(category.name))
  .flatMap((category) => category.sources
    .filter((source) => source.enabled)
    .map((source) => {
      const sourceSettings = source as typeof source & { displayName?: string };
      return {
        ...source,
        displayName: sourceSettings.displayName?.trim() || source.name,
        category: category.name,
      };
    }));
const homepages = new Map(activeSources.map((source) => [source.name, homepageOverrides[source.name] ?? new URL(source.url).origin]));
const sourceOrder = new Map(activeSources.map((source, index) => [source.name, index] as const));
const sourceCategory = new Map(activeSources.map((source) => [source.name, source.category] as const));
const sourceDisplayNames = new Map(activeSources.map((source) => [source.name, source.displayName] as const));

const allEditions = Object.values(
  import.meta.glob('../data/editions/*.json', { eager: true, import: 'default' }),
) as Edition[];
const edition = allEditions.sort((a, b) => b.date.localeCompare(a.date))[0];
const stories = edition?.stories ?? [];
const sourceGroups: SourceCollection[] = edition?.sources?.length
  ? edition.sources
  : [...new Set(stories.map((story) => `${story.source}\u0000${story.category}`))].map((key) => {
    const [source, category] = key.split('\u0000');
    const sourceStories = stories.filter((story) => story.source === source && story.category === category);
    return { name: source, category: (category ?? 'Discover') as SourceCollection['category'], stories: sourceStories };
  });
sourceGroups.forEach((group) => {
  group.category = sourceCategory.get(group.name) ?? group.category;
  group.displayName = sourceDisplayNames.get(group.name) ?? group.name;
});
sourceGroups.forEach((group) => {
  if (group.kind === 'hackernews' || group.name === 'Hacker News') return;
  group.stories.sort((a, b) => {
    const timeA = a.publishedAt ? Date.parse(a.publishedAt) : Number.NEGATIVE_INFINITY;
    const timeB = b.publishedAt ? Date.parse(b.publishedAt) : Number.NEGATIVE_INFINITY;
    return (Number.isNaN(timeB) ? Number.NEGATIVE_INFINITY : timeB) -
      (Number.isNaN(timeA) ? Number.NEGATIVE_INFINITY : timeA);
  });
});
sourceGroups.forEach((group) => {
  group.stories = group.stories.slice(0, 20);
});
sourceGroups.sort((a, b) =>
  categories.indexOf(a.category) - categories.indexOf(b.category) ||
  (sourceOrder.get(a.name) ?? Number.POSITIVE_INFINITY) - (sourceOrder.get(b.name) ?? Number.POSITIVE_INFINITY),
);
const collectionTime = edition ? formatHongKongTime(edition.generatedAt) : null;
const lastUpdated = edition && collectionTime
  ? `${formatDate(edition.generatedAt, { day: 'numeric', month: 'short', year: 'numeric' })}, ${collectionTime} HKT`
  : null;
const siteDescription = `What's happening, and a little more. No algorithms. Just one more tab. ${lastUpdated ? `Last updated ${lastUpdated}.` : ''}`.trim();
---

<Layout title="One More Tab – Links Worth Opening" description={siteDescription}>
  <SiteHeader active="latest" />
  <main class="page-shell latest-page source-navigation-page">
    <section class="latest-heading" aria-label="About this collection">
      <div class="site-intro">
        <p class="site-blurb">What's happening, and a little more.</p>
        <p class="site-description">No algorithms. Just one more tab.</p>
        <p class="last-updated">Last updated {lastUpdated ?? '—'}</p>
      </div>
    </section>

    {edition && sourceGroups.length > 0 ? (
      <>
        <div class="topic-bar-slot">
          <nav class="topic-bar" aria-label="Filter headlines by topic">
            <div class="filters">
              <Button variant="ghost" class="filter active" data-filter="All" aria-pressed="true" aria-controls="source-list">
                <span>All</span>
              </Button>
              {categories.map((category) => (
                <Button
                  variant="ghost"
                  class="filter"
                  data-filter={category}
                  aria-pressed="false"
                  aria-controls="source-list"
                >
                  <span>{category === 'Technology' ? 'Tech' : category}</span>
                </Button>
              ))}
            </div>
            <button class="desktop-source-search" type="button" data-open-sources aria-haspopup="dialog" aria-label="All sources" title="All sources">
              <span>All sources</span>
            </button>
          </nav>
        </div>

        <SourceNavigator groups={sourceGroups.filter((group) => sourceOrder.has(group.name) && group.stories.length > 0)} />
        <section class="source-list" id="source-list" aria-label="Latest headlines by source">
          {sourceGroups.filter((group) => sourceOrder.has(group.name) && group.stories.length > 0).map((group, groupIndex) => (
            <section class="source-group" id={`source-${groupIndex}`} data-source-name={group.displayName ?? group.name} data-category={group.category} data-page="1" aria-label={`${group.displayName ?? group.name} headlines`} tabindex="-1">
              <header class="source-heading">
                <div class="source-name-line">
                  <h2>{homepages.has(group.name)
                    ? <a href={homepages.get(group.name)} target="_blank" rel="noreferrer">{group.displayName ?? group.name}</a>
                    : group.displayName ?? group.name}</h2>
                </div>
                {group.stories.length > 10 && (
                  <nav class="source-pager" aria-label={`Pages of ${group.displayName ?? group.name} headlines`}>
                    {[1, 2].map((page) => (
                      <button
                        class:list={["source-page-button", page === 1 && "active"]}
                        type="button"
                        data-page={page}
                        aria-label={`Show stories 11–20 of ${group.displayName ?? group.name} headlines`}
                        aria-controls={`stories-${groupIndex}`}
                        aria-current={page === 1 ? 'page' : undefined}
                        aria-pressed={page === 1 ? 'true' : 'false'}
                      ><span class="source-page-segment" aria-hidden="true"></span></button>
                    ))}
                  </nav>
                )}
              </header>
              <div class="story-viewport" id={`stories-${groupIndex}`} data-story-viewport>
                <div class="story-track" data-story-track style="--story-track-x: 0px">
                  {[1, 2].filter((page) => group.stories.slice((page - 1) * 10, page * 10).length > 0).map((page) => (
                    <ul
                      class="story-list story-page"
                      id={`stories-${groupIndex}-page-${page}`}
                      data-story-page={page}
                      role="list"
                      aria-label={`Stories ${page === 1 ? '1–10' : '11–20'}`}
                      aria-hidden={page === 1 ? undefined : 'true'}
                      inert={page === 1 ? undefined : true}
                    >
                      {group.stories.slice((page - 1) * 10, page * 10).map((story, storyIndex) => (
                        <StoryCard story={story} referenceDate={edition?.date} page={page} initiallyHidden={false} />
                      ))}
                    </ul>
                  ))}
                </div>
              </div>
            </section>
          ))}
          <p class="empty-state" hidden>No headlines in this topic for this collection.</p>
        </section>
      </>
    ) : edition ? (
      <section class="empty-panel" aria-live="polite">
        <h2>No headlines collected</h2>
        <p>The latest collection checked {edition.sourcesChecked} sources but found no publishable stories.</p>
      </section>
    ) : (
      <section class="empty-panel first-run" aria-live="polite">
        <h2>Waiting for the first collection</h2>
        <p>When the collector runs, headlines will appear here grouped by source and ordered by publication time.</p>
      </section>
    )}

    <footer class="page-footer">
      <span>Headlines link to their original publishers.</span>
      <span>{edition ? `${edition.sourcesChecked} sources checked` : 'No collection has run yet'}</span>
    </footer>
  </main>

  <script>
    const topicBar = document.querySelector<HTMLElement>('.topic-bar');
    const mobile = window.matchMedia('(max-width: 640px)');
    const topicBarSlot = document.querySelector<HTMLElement>('.topic-bar-slot');
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const groups = [...document.querySelectorAll<HTMLElement>('.source-group')];
    const empty = document.querySelector<HTMLElement>('.empty-state');
    let selectedTopic = 'All';
    let scrollTopic: string | undefined;

    function syncStickyVisibility(remeasure = false) {
      if (!topicBar || !topicBarSlot) return;
      const pinned = mobile.matches && topicBarSlot.getBoundingClientRect().top <= 0;
      if (!remeasure && pinned === topicBar.classList.contains('is-pinned')) return;

      topicBar.classList.remove('is-pinned');
      topicBarSlot.style.height = '';
      if (pinned) {
        topicBarSlot.style.height = `${topicBarSlot.getBoundingClientRect().height}px`;
        topicBar.classList.add('is-pinned');
        scrollTopic = undefined;
        updateScrollTopic();
      } else {
        scrollTopic = undefined;
        filters.forEach((filter) => {
          const active = filter.dataset.filter === selectedTopic;
          filter.classList.toggle('active', active);
          filter.setAttribute('aria-pressed', String(active));
        });
      }
    }

    function revealActiveChip() {
      const row = topicBar?.querySelector<HTMLElement>('.filters');
      const active = topicBar?.querySelector<HTMLElement>('.filter.active');
      if (!row || !active) return;
      const rowRect = row.getBoundingClientRect();
      const chipRect = active.getBoundingClientRect();
      const inset = 16;
      if (chipRect.left < rowRect.left + inset) row.scrollLeft += chipRect.left - rowRect.left - inset;
      else if (chipRect.right > rowRect.right - inset) row.scrollLeft += chipRect.right - rowRect.right + inset;
    }

    function updateScrollTopic() {
      if (!topicBar || !topicBar.classList.contains('is-pinned')) return;
      const visible = groups.filter((group) => !group.hidden);
      const threshold = topicBar.getBoundingClientRect().height + 12;
      let current = visible[0];
      for (const group of visible) {
        if (group.getBoundingClientRect().top > threshold) break;
        current = group;
      }
      const topic = current?.dataset.category ?? selectedTopic;
      if (scrollTopic === topic) return;
      scrollTopic = topic;
      topicBar.querySelectorAll<HTMLButtonElement>('.filter').forEach((filter) => {
        const active = filter.dataset.filter === topic;
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      revealActiveChip();
    }

    function topicFromUrl() {
      const requested = new URLSearchParams(window.location.search).get('category');
      return filters.some((filter) => filter.dataset.filter === requested) ? requested! : 'All';
    }

    function updateGroups(scrollHandled: boolean) {
      let matching = 0;
      groups.forEach((group) => {
        const matches = selectedTopic === 'All' || group.dataset.category === selectedTopic;
        group.hidden = !matches;
        if (matches) matching += 1;
      });
      if (empty) empty.hidden = matching > 0;
      refreshStoryHeights();
      document.dispatchEvent(new CustomEvent('sources-filtered', { detail: { scrollHandled } }));
    }

    function selectTopic(topic: string, updateUrl: boolean, scrollHandled = false) {
      const button = filters.find((filter) => filter.dataset.filter === topic)
        ?? filters.find((filter) => filter.dataset.filter === 'All');
      if (!button) return;
      const nextTopic = button.dataset.filter ?? 'All';
      if (nextTopic !== selectedTopic) resetGroupPages();
      selectedTopic = nextTopic;
      scrollTopic = undefined;

      if (updateUrl && selectedTopic !== topicFromUrl()) {
        const url = new URL(window.location.href);
        if (selectedTopic === 'All') url.searchParams.delete('category');
        else url.searchParams.set('category', selectedTopic);
        window.history.pushState({}, '', url);
      }

      filters.forEach((filter) => {
        const active = filter.dataset.filter === selectedTopic;
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      updateGroups(scrollHandled);
      if (topicBar?.classList.contains('is-pinned')) updateScrollTopic();
    }

    document.addEventListener('source-category-reset', () => selectTopic('All', true));

    const reducedStoryMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const storyViewports = new Map<HTMLElement, {
      viewport: HTMLElement;
      track: HTMLElement;
      panels: HTMLElement[];
      pageHeights: Map<number, number>;
      lastHeight: number;
      compensateAbove: boolean;
      clampAfterTransition: { top: number; height: number } | undefined;
    }>();

    function pageHeight(panel: HTMLElement) {
      return panel.getBoundingClientRect().height + 1;
    }

    function setGroupPage(group: HTMLElement, page: number, animate = true) {
      const state = storyViewports.get(group);
      if (!state) return;
      const maxPage = Math.max(1, ...state.panels.map((panel) => Number(panel.dataset.storyPage) || 1));
      const nextPage = Math.min(maxPage, Math.max(1, page));
      const viewportRect = state.viewport.getBoundingClientRect();
      const hidden = group.hidden;
      const oldHeight = viewportRect.height || Number.parseFloat(state.viewport.style.height) || 0;
      const newPanel = state.panels.find((panel) => Number(panel.dataset.storyPage) === nextPage) ?? state.panels[0];
      if (!newPanel) return;
      const nextHeight = hidden
        ? state.pageHeights.get(nextPage) ?? pageHeight(newPanel)
        : pageHeight(newPanel);
      if (!hidden) state.pageHeights.set(nextPage, nextHeight);
      const documentTop = viewportRect.top + window.scrollY;
      const wasAbove = !hidden && viewportRect.height > 0 && viewportRect.bottom <= 0;
      const wasIntersecting = !hidden && viewportRect.height > 0 && viewportRect.top < 0 && viewportRect.bottom > 0;
      state.clampAfterTransition = wasIntersecting && nextHeight < oldHeight
        ? { top: documentTop, height: nextHeight }
        : undefined;
      const heightChanged = Math.abs(nextHeight - oldHeight) > 1;
      state.compensateAbove = wasAbove && heightChanged && animate && !reducedStoryMotion.matches;

      group.dataset.page = String(nextPage);
      state.panels.forEach((panel) => {
        const active = Number(panel.dataset.storyPage) === nextPage;
        panel.inert = !active;
        if (active) panel.removeAttribute('aria-hidden');
        else panel.setAttribute('aria-hidden', 'true');
      });
      group.querySelectorAll<HTMLButtonElement>('.source-page-button').forEach((button) => {
        const active = Number(button.dataset.page) === nextPage;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
        const togglePage = nextPage === 1 ? 2 : 1;
        button.setAttribute('aria-label', `Show stories ${togglePage === 1 ? '1–10' : '11–20'} of ${group.getAttribute('aria-label') ?? 'headlines'}`);
        if (active) button.setAttribute('aria-current', 'page');
        else button.removeAttribute('aria-current');
      });
      state.viewport.style.height = `${nextHeight}px`;
      state.track.style.setProperty('--story-track-x', nextPage === 1 ? '0px' : `${-state.viewport.clientWidth}px`);
      if (!animate || reducedStoryMotion.matches) {
        state.viewport.classList.add('is-immediate');
        void state.viewport.offsetHeight;
        requestAnimationFrame(() => state.viewport.classList.remove('is-immediate'));
      }
      if (wasAbove && heightChanged && (!animate || reducedStoryMotion.matches)) window.scrollBy(0, nextHeight - oldHeight);
      if (wasIntersecting && nextHeight < oldHeight && window.scrollY > documentTop + nextHeight - 80) {
        window.scrollTo(0, Math.max(0, documentTop + Math.max(0, nextHeight - 80)));
      }
      if (!animate || reducedStoryMotion.matches) {
        state.clampAfterTransition = undefined;
        state.compensateAbove = false;
      }
    }

    function resetGroupPages() {
      groups.forEach((group) => setGroupPage(group, 1, false));
    }

    function readTrackX(track: HTMLElement) {
      const transform = getComputedStyle(track).transform;
      if (!transform || transform === 'none') return 0;
      return new DOMMatrixReadOnly(transform).m41;
    }

    let suppressedStoryViewport: HTMLElement | undefined;
    let suppressStoryClickUntil = 0;
    document.addEventListener('click', (event) => {
      if (performance.now() < suppressStoryClickUntil && suppressedStoryViewport
        && event.target instanceof Node && suppressedStoryViewport.contains(event.target)) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    }, true);

    function installStorySwipe(group: HTMLElement, state: { viewport: HTMLElement; track: HTMLElement; panels: HTMLElement[] }) {
      const { viewport, track, panels } = state;
      let gesture: {
        touchId: number;
        startX: number;
        startY: number;
        lastX: number;
        lastTime: number;
        velocity: number;
        baseX: number;
        startPage: number;
        claimed: boolean;
      } | undefined;
      function cancelGesture() {
        if (!gesture) return;
        const cancelled = gesture;
        gesture = undefined;
        if (!cancelled.claimed) return;
        suppressedStoryViewport = viewport;
        suppressStoryClickUntil = performance.now() + 400;
        viewport.classList.remove('is-dragging');
        setGroupPage(group, cancelled.startPage, true);
      }

      viewport.addEventListener('touchstart', (event) => {
        if (gesture && event.touches.length !== 1) {
          cancelGesture();
          return;
        }
        if (!mobile.matches || gesture || event.touches.length !== 1) return;
        const touch = event.changedTouches[0];
        if (!touch) return;
        gesture = {
          touchId: touch.identifier,
          startX: touch.clientX,
          startY: touch.clientY,
          lastX: touch.clientX,
          lastTime: performance.now(),
          velocity: 0,
          baseX: readTrackX(track),
          startPage: Number(group.dataset.page) || 1,
          claimed: false,
        };
      }, { passive: true });

      viewport.addEventListener('touchmove', (event) => {
        if (!gesture) return;
        if (event.touches.length !== 1 || !event.cancelable) {
          cancelGesture();
          return;
        }
        const touch = [...event.changedTouches].find((candidate) => candidate.identifier === gesture!.touchId);
        if (!touch) return;
        const dx = touch.clientX - gesture.startX;
        const dy = touch.clientY - gesture.startY;
        if (!gesture.claimed) {
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
          if (Math.abs(dx) < Math.abs(dy) * 1.2) {
            if (Math.abs(dy) > Math.abs(dx) * 1.2) gesture = undefined;
            return;
          }
          event.preventDefault();
          gesture.claimed = true;
          viewport.classList.add('is-dragging');
          window.getSelection()?.removeAllRanges();
        } else {
          event.preventDefault();
        }
        const width = Math.max(1, viewport.clientWidth);
        let nextX = gesture.baseX + dx;
        if (nextX > 0) nextX *= 0.22;
        if (nextX < -width) nextX = -width + (nextX + width) * 0.22;
        track.style.setProperty('--story-track-x', `${nextX}px`);
        const now = performance.now();
        gesture.velocity = (touch.clientX - gesture.lastX) / Math.max(1, now - gesture.lastTime);
        gesture.lastX = touch.clientX;
        gesture.lastTime = now;
      }, { passive: false });

      function finishGesture(touch: Touch, cancelled = false) {
        if (!gesture || gesture.touchId !== touch.identifier) return;
        const finished = gesture;
        gesture = undefined;
        if (!finished.claimed) return;
        suppressedStoryViewport = viewport;
        suppressStoryClickUntil = performance.now() + 400;
        const dx = touch.clientX - finished.startX;
        const width = Math.max(1, viewport.clientWidth);
        const enoughTravel = Math.abs(dx) >= width * 0.25;
        const recentMovement = performance.now() - finished.lastTime <= 100;
        const enoughFlick = recentMovement && Math.abs(dx) >= 20 && Math.abs(finished.velocity) > 0.45 && Math.sign(finished.velocity) === Math.sign(dx);
        const committed = !cancelled && (enoughTravel || enoughFlick);
        const targetPage = committed
          ? Math.max(1, Math.min(panels.length, finished.startPage + (dx < 0 ? 1 : -1)))
          : finished.startPage;
        viewport.classList.remove('is-dragging');
        setGroupPage(group, targetPage, true);
      }

      viewport.addEventListener('touchend', (event) => {
        const touch = [...event.changedTouches].find((candidate) => candidate.identifier === gesture?.touchId);
        if (touch) finishGesture(touch);
      }, { passive: true });
      viewport.addEventListener('touchcancel', (event) => {
        if (event.changedTouches.length) cancelGesture();
      }, { passive: true });
    }

    groups.forEach((group) => {
      const viewport = group.querySelector<HTMLElement>('[data-story-viewport]');
      const track = group.querySelector<HTMLElement>('[data-story-track]');
      const panels = [...group.querySelectorAll<HTMLElement>('[data-story-page]')];
      if (!viewport || !track || !panels.length) return;
      const pageHeights = new Map(panels.map((panel) => [Number(panel.dataset.storyPage), pageHeight(panel)]));
      const state = {
        viewport,
        track,
        panels,
        pageHeights,
        lastHeight: 0,
        compensateAbove: false,
        clampAfterTransition: undefined as { top: number; height: number } | undefined,
      };
      storyViewports.set(group, state);
      const initialPage = Number(group.dataset.page) || 1;
      panels.forEach((panel) => {
        const active = Number(panel.dataset.storyPage) === initialPage;
        panel.inert = !active;
        if (active) panel.removeAttribute('aria-hidden');
        else panel.setAttribute('aria-hidden', 'true');
      });
      const initialPanel = panels.find((panel) => Number(panel.dataset.storyPage) === initialPage) ?? panels[0];
      viewport.style.height = `${pageHeight(initialPanel)}px`;
      track.style.setProperty('--story-track-x', initialPage === 1 ? '0px' : `${-viewport.clientWidth}px`);
      state.lastHeight = viewport.getBoundingClientRect().height;
      const resizeObserver = new ResizeObserver(() => {
        const currentHeight = viewport.getBoundingClientRect().height;
        if (state.compensateAbove && Math.abs(currentHeight - state.lastHeight) > 0.5) {
          window.scrollBy(0, currentHeight - state.lastHeight);
        }
        state.lastHeight = currentHeight;
      });
      resizeObserver.observe(viewport);
      viewport.addEventListener('transitionend', (event) => {
        if (event.propertyName !== 'height') return;
        state.compensateAbove = false;
        if (!state.clampAfterTransition) return;
        const rect = viewport.getBoundingClientRect();
        if (rect.bottom <= 0) {
          const { top, height } = state.clampAfterTransition;
          window.scrollTo(0, Math.max(0, top + Math.max(0, height - 96)));
        }
        state.clampAfterTransition = undefined;
      });
      group.querySelectorAll<HTMLButtonElement>('.source-page-button').forEach((button) => {
        button.addEventListener('click', () => {
          const currentPage = Number(group.dataset.page) || 1;
          setGroupPage(group, currentPage === 1 ? 2 : 1);
        });
      });
      if (panels.length > 1) installStorySwipe(group, state);
    });

    function refreshStoryHeights() {
      groups.forEach((group) => setGroupPage(group, Number(group.dataset.page) || 1, false));
    }

    window.addEventListener('resize', refreshStoryHeights);
    document.fonts.ready.then(refreshStoryHeights);

    filters.forEach((button) => button.addEventListener('click', () => {
      const topic = button.dataset.filter ?? 'All';
      if (!topicBar?.classList.contains('is-pinned') || !topicBarSlot) {
        selectTopic(topic, true);
        return;
      }
      selectTopic(topic, true, true);
      const target = groups.find((group) => !group.hidden);
      if (target) {
        const top = target.getBoundingClientRect().top + window.scrollY - topicBar.offsetHeight - 8;
        const pinTop = Math.ceil(topicBarSlot.getBoundingClientRect().top + window.scrollY);
        window.scrollTo({ top: Math.max(pinTop, top), behavior: 'instant' });
        updateScrollTopic();
      }
    }));
    let scrollPending = false;
    window.addEventListener('scroll', () => {
      if (scrollPending) return;
      scrollPending = true;
      requestAnimationFrame(() => {
        scrollPending = false;
        syncStickyVisibility();
        updateScrollTopic();
      });
    }, { passive: true });
    mobile.addEventListener('change', () => syncStickyVisibility(true));
    window.addEventListener('resize', () => syncStickyVisibility(true));
